{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name. `pnpm init-project` stamps a per-client name ("{slug}-site");
  // the Deploy to Cloudflare button uses this value as the default.
  "name": "septic-template",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Deploy Buttons read package.json's `build` and `deploy` scripts. This hook
  // also makes Cloudflare's fallback `npx wrangler deploy` safe: the OpenNext
  // Worker is generated (after the CMS snapshot step) before Wrangler reads
  // the entry point.
  "build": {
    "command": "pnpm build && pnpm exec opennextjs-cloudflare build"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Custom domain: attach a route in the Cloudflare dashboard, or set
  // ROUTE_PATTERN + ROUTE_ZONE_ID when running `pnpm init-project`, which
  // writes:
  // "routes": [{ "pattern": "www.clientdomain.com/*", "zone_id": "<zone id>" }]
}
