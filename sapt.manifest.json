            "options": {
              "choices": [
                { "id": "missed_call", "slug": "missed_call", "label": "Missed call" },
                { "id": "web_form", "slug": "web_form", "label": "Website quote form" },
                { "id": "chat_widget", "slug": "chat_widget", "label": "Chat widget" },
                { "id": "google", "slug": "google", "label": "Google Business Profile" },
                { "id": "referral", "slug": "referral", "label": "Referral" },
                { "id": "other", "slug": "other", "label": "Other" }
              ]
            }
          }
        },
