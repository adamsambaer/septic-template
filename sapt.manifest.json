          "schema": {
            "type": "select",
            "options": {
              "choices": [
                { "id": "emergency_now", "slug": "emergency_now", "label": "Emergency, today" },
                { "id": "this_week", "slug": "this_week", "label": "This week" },
                { "id": "this_month", "slug": "this_month", "label": "This month" },
                { "id": "just_pricing", "slug": "just_pricing", "label": "Just getting pricing" }
