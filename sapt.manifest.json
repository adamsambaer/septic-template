          "schema": {
            "type": "select",
            "options": {
              "choices": [
                { "id": "backup_emergency", "slug": "backup_emergency", "label": "Backup or overflow (emergency)" },
                { "id": "pump_out", "slug": "pump_out", "label": "Routine pump-out" },
                { "id": "inspection", "slug": "inspection", "label": "Inspection or real estate cert" },
                { "id": "repair", "slug": "repair", "label": "Repair" },
                { "id": "new_system", "slug": "new_system", "label": "New system or drain field" },
                { "id": "unsure", "slug": "unsure", "label": "Not sure" }
              ]
            }
          }
        },
        "urgency": {
          "label": "Urgency",
