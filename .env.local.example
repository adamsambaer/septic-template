# ─── Sapt configuration ──────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your values.

# REQUIRED — your Sapt project UUID (from the Sapt dashboard).
# Powers analytics and the quote form, which posts to the `lead` object type.
NEXT_PUBLIC_SAPT_PROJECT_ID=your-project-id-here

# REQUIRED IN PRODUCTION — the site's public URL. Without it, social share
# images and canonical URLs resolve to localhost.
NEXT_PUBLIC_SITE_URL=https://www.your-client-domain.com

# OPTIONAL — API base URL (defaults to https://api.sapt.ai).
# NEXT_PUBLIC_SAPT_BASE_URL=https://api.sapt.ai

# OPTIONAL — analytics ingest URL (defaults to https://ingest.sapt.ai).
# NEXT_PUBLIC_SAPT_INGEST_URL=https://ingest.sapt.ai

# BUILD-TIME ONLY — used by `pnpm pull` (scripts/pull-cms.mjs) to snapshot the
# client's Sapt project (Branding + CMS + assets) into
# src/config/site-config.generated.json before the build. Create a project
# service-account API key in the Sapt dashboard with read access to CMS,
# assets and branding. Never prefix with NEXT_PUBLIC_ and never commit a real key.
# Without it the site builds with the demo content in src/config/site-config.ts.
# SAPT_API_KEY=sapt_xxxxxxxxxxxxxxxx

