# Cloudflare's Deploy Button reads this file and prompts for each value.
# Both are public identifiers, not secrets.

# The client's Sapt project. Where the quote form posts leads and what the
# analytics tag reports to. Copy it from the Sapt dashboard.
NEXT_PUBLIC_SAPT_PROJECT_ID=your-project-id-here

# The live domain, with https://. Drives canonical URLs, share images and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.your-client-domain.com
